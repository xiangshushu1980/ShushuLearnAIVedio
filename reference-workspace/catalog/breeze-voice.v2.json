  "templates": [
    {
      "id": "daily",
      "name": "日常交流",
      "version": 1,
      "languages": {
        "zh": [
          {
            "label": "平静",
            "text": "你好，很高兴见到你。我们慢慢说，不用着急。",
            "direction": "自然、平静，像面对面聊天。"
          },
          {
            "label": "喜悦",
            "text": "太好了，这件事终于完成了。我想把这个好消息告诉你。",
            "direction": "轻微喜悦，自然口语，不唱歌。"
          },
          {
            "label": "认真",
            "text": "请先听我说完，这件事很重要，我们需要一起想办法。",
            "direction": "认真坚定，吐字清楚，不喊叫。"
          }
        ],
        "en": [
          {
            "label": "Calm",
            "text": "Hello. It is good to see you. Take your time, there is no rush.",
            "direction": "Speak naturally and calmly, like a face-to-face conversation."
          },
          {
            "label": "Happy",
            "text": "That is wonderful. We finally finished it, and I wanted to share the good news.",
            "direction": "Gently cheerful natural speech. Do not sing."
          },
          {
            "label": "Serious",
            "text": "Please hear me out. This matters, and we need to find a way forward together.",
            "direction": "Serious and clear, without shouting."
          }
        ]
      }
    },
    {
      "id": "drama",
      "name": "剧情对白",
      "version": 1,
      "languages": {
        "zh": [
          {
            "label": "平静",
            "text": "你终于回来了。我一直在这里等你。",
            "direction": "平静克制，像自然的剧情对白。"
          },
          {
            "label": "坚定",
            "text": "我已经想好了。无论发生什么，我都会走下去。",
            "direction": "坚定但不过分激动，不喊叫。"
          },
          {
            "label": "低落",
            "text": "我明白你的意思，只是还有些话，不知道该怎么说。",
            "direction": "轻微失落，低声但吐字清楚。"
          }
        ],
        "en": [
          {
            "label": "Calm",
            "text": "You are finally back. I have been waiting here for you.",
            "direction": "Calm, restrained, natural dialogue."
          },
          {
            "label": "Determined",
            "text": "I have made up my mind. Whatever happens, I will keep going.",
            "direction": "Firm and determined, without shouting."
          },
          {
            "label": "Sad",
            "text": "I understand what you mean. There are still things I do not know how to say.",
            "direction": "Gently sad, quiet but clear speech."
          }
        ]
      }
    },
    {
      "id": "narration",
      "name": "解说旁白",
      "version": 1,
      "languages": {
        "zh": [
          {
            "label": "讲述",
            "text": "清晨的光照进房间，新的一天从这里开始。",
            "direction": "自然的旁白，语速适中。"
          },
          {
            "label": "说明",
            "text": "接下来，我们会用三个简单的步骤，说明这个过程。",
            "direction": "清楚易懂的说明，不夸张。"
          },
          {
            "label": "收束",
            "text": "感谢你听到这里，我们下次再见。",
            "direction": "温和自然地结束，保留完整句尾。"
          }
        ],
        "en": [
          {
            "label": "Narration",
            "text": "Morning light fills the room. A new day begins here.",
            "direction": "Natural narration at a moderate pace."
          },
          {
            "label": "Explanation",
            "text": "Next, we will explain this process in three simple steps.",
            "direction": "Clear, accessible explanation without exaggeration."
          },
          {
            "label": "Closing",
            "text": "Thank you for listening. I look forward to seeing you next time.",
            "direction": "Warm natural closing. Finish the last word clearly."
          }
        ]
      }
    },
    {
      "id": "hero",
      "name": "冒险与决心",
      "version": 1,
      "languages": {
        "zh": [
          {
            "id": "calm",
            "label": "平静",
            "text": "前面的路还很长，我们先休息一下。",
            "direction": "自然平静地说话。"
          },
          {
            "id": "excited",
            "label": "兴奋",
            "text": "看到了吗？我们终于找到它了！",
            "direction": "兴奋但不尖叫，自然说话。"
          },
          {
            "id": "firm",
            "label": "坚定",
            "text": "我会守住这里，你们放心向前走。",
            "direction": "语气坚定沉着，不吼叫。"
          }
        ],
        "en": [
          {
            "id": "calm",
            "label": "平静",
            "text": "The road ahead is long. Let us rest for a moment.",
            "direction": "Speak calmly and naturally."
          },
          {
            "id": "excited",
            "label": "兴奋",
            "text": "Did you see that? We finally found it!",
            "direction": "Sound excited without shouting."
          },
          {
            "id": "firm",
            "label": "坚定",
            "text": "I will hold this place. Keep moving forward.",
            "direction": "Sound firm and composed without shouting."
          }
        ]
      }
    },
    {
      "id": "intimate",
      "name": "关心与安慰",
      "version": 1,
      "languages": {
        "zh": [
          {
            "id": "care",
            "label": "关心",
            "text": "你今天是不是很累？先坐下来休息一会儿。",
            "direction": "关心对方，自然温柔。"
          },
          {
            "id": "comfort",
            "label": "安慰",
            "text": "没关系，我会陪着你，我们慢慢来。",
            "direction": "轻柔安慰，不哭泣。"
          },
          {
            "id": "relief",
            "label": "释然",
            "text": "听到你这么说，我终于可以放心了。",
            "direction": "轻微释然，语气放松。"
          }
        ],
        "en": [
          {
            "id": "care",
            "label": "关心",
            "text": "Are you tired today? Sit down and rest for a while.",
            "direction": "Sound caring and natural."
          },
          {
            "id": "comfort",
            "label": "安慰",
            "text": "It is all right. I will stay with you. We can take our time.",
            "direction": "Gently reassure without crying."
          },
          {
            "id": "relief",
            "label": "释然",
            "text": "Hearing you say that, I can finally relax.",
            "direction": "Sound relieved and relaxed."
          }
        ]
      }
    }
  ],
