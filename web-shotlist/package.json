{
  "name": "shotlist-tool",
  "private": true,
  "version": "0.1.0",
  "description": "拍摄本看板 Web 工具（docs/22）— 剧本 → 拍摄本 → 提示词 → 渲染输入源",
  "scripts": {
    "dev": "pnpm --parallel --filter @shotlist/server --filter @shotlist/web dev",
    "dev:server": "pnpm --filter @shotlist/server dev",
    "dev:web": "pnpm --filter @shotlist/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.16.0"
}
